{
  "name": "dsh-todo-editor",
  "version": "0.1.0",
  "description": "Editable task-flow panel for DeepSeek Harness: design the checklist yourself, save it straight into the session, and let the agent execute your nodes one by one.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "patches",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "todo",
    "task-list",
    "checklist"
  ],
  "license": "MIT",
  "author": "lmk2215",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmk2215/dsh-todo-editor.git"
  },
  "homepage": "https://github.com/lmk2215/dsh-todo-editor#readme",
  "bugs": {
    "url": "https://github.com/lmk2215/dsh-todo-editor/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
